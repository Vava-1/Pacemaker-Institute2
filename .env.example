# Database
DATABASE_URL="mysql://root:password@localhost:3306/pacemaker"

# Security
JWT_ACCESS_SECRET="dev_secret_access_key_change_in_prod"
JWT_REFRESH_SECRET="dev_secret_refresh_key_change_in_prod"

# Frontend URL (for CORS and OAuth redirects)
FRONTEND_URL="http://localhost:5173"

# ==========================================
# The following settings can also be configured
# in the Admin Panel settings once deployed.
# ==========================================

# Stripe Payments
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/oauth/google/callback"

# AI Tutor
ANTHROPIC_API_KEY="sk-ant-..."

# File Uploads (Cloudinary)
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# SMTP Email
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASSWORD="your_smtp_password"
SMTP_FROM_NAME="Pacemaker Institute"
SMTP_FROM_EMAIL="noreply@pacemakerinstitute.com"
