# =====================================================
# Pacemaker Institute - Environment Variables Reference
# =====================================================
# Copy this file to .env (cp .env.example .env) and fill in real values.
# The server will refuse to boot in production if any required value is missing.

# Runtime
NODE_ENV="development"
PORT="3000"

# Database (MySQL) - REQUIRED
DATABASE_URL="mysql://root:password@localhost:3306/pacemaker"

# Auth secrets - REQUIRED, min 16 chars each
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="dev_access_secret_change_me_min_16_chars"
JWT_REFRESH_SECRET="dev_refresh_secret_change_me_min_16_chars"

# Public URL of the app (used for CORS, OAuth callbacks, email links)
FRONTEND_URL="http://localhost:5173"

# =====================================================
# The following settings can also be configured in the
# Admin Panel settings once deployed. env vars take
# precedence as the initial fallback.
# =====================================================

# Stripe Payments
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Google OAuth (optional)
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
# If unset, auto-derived as ${FRONTEND_URL}/api/oauth/google/callback
# GOOGLE_CALLBACK_URL="http://localhost:3000/api/oauth/google/callback"

# AI Tutor
ANTHROPIC_API_KEY="sk-ant-..."

# File Uploads (Cloudinary) - optional
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# SMTP Email
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASSWORD="your_smtp_password"
SMTP_FROM_NAME="Pacemaker Institute"
SMTP_FROM_EMAIL="noreply@yourdomain.com"

# Error monitoring (optional) - POST JSON to this URL on error
# ERROR_WEBHOOK_URL="https://hooks.slack.com/services/..."

# Logging - debug | info | warn | error
LOG_LEVEL="info"
