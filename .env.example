# =============================================================================
# Pacemaker Institute - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# =============================================================================

# --- CORE SETTINGS ---

# Application environment: development | production | test
NODE_ENV="development"

# Server port
PORT="3000"

# Database connection string (MySQL)
# Format: mysql://user:password@host:port/database
# Example: mysql://root:password@localhost:3306/pacemaker
DATABASE_URL="mysql://root:password@localhost:3306/pacemaker"

# --- JWT SECRETS ---
# Generate with: openssl rand -hex 32
# Minimum 32 characters each
JWT_ACCESS_SECRET="change_me_to_a_random_32_character_string"
JWT_REFRESH_SECRET="change_me_to_another_random_32_character_string"

# Frontend URL (CORS, OAuth callbacks, email links)
FRONTEND_URL="http://localhost:5173"

# --- STRIPE PAYMENTS ---
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# --- GOOGLE OAUTH ---
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
# Auto-derived from FRONTEND_URL if not set:
# GOOGLE_CALLBACK_URL="http://localhost:3000/api/oauth/google/callback"

# --- AI TUTOR MODELS ---
# Three AI providers race concurrently — fastest response wins, auto-failover.
# At least one key is needed for AI Tutor / PI Assistant.
# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# xAI Grok: https://console.x.ai
GROK_API_KEY=""
# DeepSeek: https://platform.deepseek.com
DEEPSEEK_API_KEY=""

# --- CLOUDINARY (File Uploads) ---
# Get from https://console.cloudinary.com/settings
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# --- SMTP EMAIL ---
# Supported: SendGrid, Mailgun, AWS SES, SMTP2GO, any SMTP provider
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASSWORD="your_smtp_password"
SMTP_FROM_NAME="Pacemaker Institute"
SMTP_FROM_EMAIL="noreply@pacemakerinstitute.com"

# --- MONITORING ---

# Error webhook (Slack, Discord, etc.) - POST JSON on errors
ERROR_WEBHOOK_URL=""

# Log level: debug | info | warn | error
LOG_LEVEL="info"

# Sentry error tracking (optional)
# Get from https://sentry.io/settings/account/keys/
SENTRY_DSN=""

# --- RATE LIMITING ---
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="100"

# --- RAILWAY-SPECIFIC ---
# Railway auto-sets these — you do NOT need to set them manually:
# RAILWAY_PUBLIC_DOMAIN, RAILWAY_HOSTNAME, DATABASE_URL (if MySQL is provisioned)
#
# For Railway deployment:
# 1. Set NODE_ENV=production
# 2. Set PORT=3000
# 3. Generate JWT secrets: openssl rand -hex 32
# 4. Add MySQL database in Railway dashboard — it auto-injects DATABASE_URL
